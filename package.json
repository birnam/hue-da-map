{
  "name": "hue-da-map",
  "version": "0.1.0",
  "description": "Hue da Map — fix 3MF colors and map them onto Snapmaker U1 filament slots",
  "type": "module",
  "bin": {
    "huedamap": "bin/convert.mjs"
  },
  "scripts": {
